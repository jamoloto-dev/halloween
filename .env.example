# Server Configuration
HOST=0.0.0.0
PORT=5000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage Configuration
DATABASE_PATH=data/halloween.db
DATABASE_URL=sqlite:///data/halloween.db
QUESTIONS_FILE=assets/questions.json

# Domain & Security
CUSTOM_DOMAIN=halloween.jamoloto.dev
CORS_ORIGINS=*
SECRET_KEY=change-this-in-production-super-spooky-secret

# Production Notes:
# In production, set:
# ENVIRONMENT=production
# CUSTOM_DOMAIN=halloween.jamoloto.dev
